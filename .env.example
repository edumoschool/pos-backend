# Copy to .env for local development. Never commit the real .env.
# For Coolify deployment see DEPLOYMENT.md — most of these are injected there.

NODE_ENV=development
PORT=7000

# DATABASE_URL is used at runtime by the Prisma pg adapter.
# DIRECT_URL is used by prisma.config.ts for migrations.
# Identical unless you put a connection pooler in front of Postgres.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pos?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/pos?schema=public

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# All MINIO_* values are read with getOrThrow: the app will not start
# if any of them is missing.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=pos-images

# Also read with getOrThrow — required even in development.
TELEGRAM_BOT_TOKEN=
# Only used when NODE_ENV=production; enables webhook mode instead of polling.
TELEGRAM_WEBHOOK_DOMAIN=

# Optional: Expo push notifications.
EXPO_ACCESS_TOKEN=
